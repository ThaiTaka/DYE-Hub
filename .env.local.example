# Copy this file to .env.local and fill in your Supabase project's values
# (Settings > API in the Supabase dashboard). Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Not required for the login/register flow; only needed if you
# add admin-level Supabase operations later. Never expose to the client.
SUPABASE_SECRET_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
